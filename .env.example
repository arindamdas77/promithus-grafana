# Copy to .env and fill in real values. .env is gitignored.
# Grafana admin password here is used by scripts/health-check.sh.
# It does not reset a Grafana database that already exists in grafana_data.

GRAFANA_USER=admin
GRAFANA_PASSWORD=change-me

# Optional notification channels. Leave blank to keep them unconfigured.
SMTP_HOST=
SMTP_PORT=587
SMTP_FROM=
SMTP_TO=
SMTP_USER=
SMTP_PASSWORD=
SMTP_REQUIRE_TLS=true

# Provider webhook for SMS. Leave blank to keep SMS unconfigured.
SMS_WEBHOOK_URL=

# Generic alert webhook. Leave blank to keep it unconfigured.
ALERT_WEBHOOK_URL=
