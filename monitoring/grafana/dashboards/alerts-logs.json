    {
      "id": 9,
      "type": "table",
      "title": "Website alerts",
      "description": "One row per firing website or SSL alert.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus-1"
      },
      "gridPos": {
        "h": 9,
        "w": 24,
        "x": 0,
        "y": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "(label_replace((label_join(ALERTS{alertstate=\"firing\",category=~\"website|ssl\"}, \"alert_key\", \"/\", \"alertname\", \"server\", \"website\", \"instance\")), \"__name__\", \"firing\", \"alertname\", \".+\")) or (label_replace(label_replace(label_replace(vector(0), \"alertname\", \"No website alerts\", \"__name__\", \".*\"), \"alert_key\", \"none\", \"__name__\", \".*\"), \"__name__\", \"firing\", \"alertname\", \"No website alerts\") unless on() (ALERTS{alertstate=\"firing\",category=~\"website|ssl\"}))",
          "instant": true,
          "range": false,
          "editorMode": "code",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus-1"
          },
          "legendFormat": ""
        },
        {
          "refId": "B",
          "expr": "(label_replace((label_join((ALERTS_FOR_STATE{category=~\"website|ssl\"} * 1000), \"alert_key\", \"/\", \"alertname\", \"server\", \"website\", \"instance\")), \"__name__\", \"started_ms\", \"alertname\", \".+\")) or (label_replace(label_replace(label_replace(vector(0), \"alertname\", \"No website alerts\", \"__name__\", \".*\"), \"alert_key\", \"none\", \"__name__\", \".*\"), \"__name__\", \"started_ms\", \"alertname\", \"No website alerts\") unless on() (ALERTS{alertstate=\"firing\",category=~\"website|ssl\"}))",
          "instant": true,
          "range": false,
          "editorMode": "code",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus-1"
          },
          "legendFormat": ""
        },
        {
          "refId": "C",
          "expr": "(label_replace((label_join((time() - ALERTS_FOR_STATE{category=~\"website|ssl\"}), \"alert_key\", \"/\", \"alertname\", \"server\", \"website\", \"instance\")), \"__name__\", \"duration_s\", \"alertname\", \".+\")) or (label_replace(label_replace(label_replace(vector(0), \"alertname\", \"No website alerts\", \"__name__\", \".*\"), \"alert_key\", \"none\", \"__name__\", \".*\"), \"__name__\", \"duration_s\", \"alertname\", \"No website alerts\") unless on() (ALERTS{alertstate=\"firing\",category=~\"website|ssl\"}))",
          "instant": true,
          "range": false,
          "editorMode": "code",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus-1"
          },
          "legendFormat": ""
        }
      ],
      "transformations": [
        {
          "id": "joinByLabels",
          "options": {
            "join": [
              "alert_key"
            ],
            "value": "__name__"
          }
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "instance": true,
              "job": true,
              "Time": true,
              "__name__": true,
              "alert_key": true,
              "alertstate": true,
              "category": true,
              "target": true
            },
            "indexByName": {
              "alertname": 0,
              "severity": 1,
              "server": 2,
              "website": 3,
              "started_ms": 4,
              "duration_s": 5
            },
            "renameByName": {
              "alertname": "Alert",
              "severity": "Severity",
              "server": "Server",
              "website": "Website",
              "started_ms": "Started",
              "duration_s": "Duration"
            }
          }
        },
        {
          "id": "sortBy",
          "options": {
            "sort": [
              {
                "desc": false,
                "field": "Severity"
              }
            ]
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Severity"
            },
            "properties": [
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "critical": {
                        "text": "critical",
                        "color": "red"
                      },
                      "warning": {
                        "text": "warning",
                        "color": "orange"
                      }
                    }
                  }
                ]
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "mode": "basic",
                  "type": "color-background"
                }
              },
              {
                "id": "custom.width",
                "value": 120
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Started"
            },
            "properties": [
              {
                "id": "unit",
                "value": "dateTimeAsIso"
              },
              {
                "id": "decimals",
                "value": 0
              },
              {
                "id": "custom.width",
                "value": 190
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Duration"
            },
            "properties": [
              {
                "id": "unit",
                "value": "s"
              },
              {
                "id": "decimals",
                "value": 0
              },
              {
                "id": "custom.width",
                "value": 130
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Alert"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 240
              },
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "WebsiteDown": {
                        "text": "Website is down"
                      },
                      "WebsiteSlow": {
                        "text": "Website is slow"
                      },
                      "SSLCertificateExpiringSoon": {
                        "text": "SSL expires within 14 days"
                      },
                      "SSLCertificateCritical": {
                        "text": "SSL expires within 3 days"
                      },
                      "ServerDown": {
                        "text": "Server is down"
                      },
                      "NodeExporterDown": {
                        "text": "Node Exporter is down"
                      },
                      "HighCPU": {
                        "text": "CPU above 80%"
                      },
                      "CriticalCPU": {
                        "text": "CPU above 95%"
                      },
                      "HighMemory": {
                        "text": "Memory above 80%"
                      },
                      "CriticalMemory": {
                        "text": "Memory above 90%"
                      },
                      "HighDisk": {
                        "text": "Disk above 80%"
                      },
                      "CriticalDisk": {
                        "text": "Disk above 90%"
                      },
                      "HighLoad": {
                        "text": "Load is high"
                      },
                      "HighSwap": {
                        "text": "Swap above 50%"
                      },
                      "MonitoringComponentDown": {
                        "text": "Monitoring component is down"
                      }
                    }
                  }
                ]
              },
              {
                "id": "links",
                "value": [
                  {
                    "title": "Server detail",
                    "url": "/d/server-detail/server-detail?var-server=${__data.fields.Server}"
                  },
                  {
                    "title": "Website",
                    "url": "/d/website-monitoring/website-monitoring-48-sites?var-website=${__data.fields.Website}"
                  }
                ]
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": false,
          "reducer": [
            "sum"
          ],
          "countRows": false,
          "fields": ""
        },
        "sortBy": [
          {
            "displayName": "Severity",
            "desc": false
          }
        ],
        "frameIndex": 0
      }
    },
