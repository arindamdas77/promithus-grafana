    {
      "id": 10,
      "type": "table",
      "title": "Servers",
      "description": "One row per server. Open Server Detail from a server name.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus-1"
      },
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 5
      },
      "targets": [
        {
          "refId": "A",
          "expr": "label_replace((max by (server, environment) (up{job=~\"server-0[123]\"})), \"__name__\", \"up_status\", \"server\", \".+\")",
          "instant": true,
          "range": false,
          "editorMode": "code",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus-1"
          },
          "legendFormat": ""
        },
        {
          "refId": "B",
          "expr": "label_replace((avg by (server, environment) (100 - (rate(node_cpu_seconds_total{mode=\"idle\",job=~\"server-0[123]\"}[5m]) * 100))), \"__name__\", \"cpu_pct\", \"server\", \".+\")",
          "instant": true,
          "range": false,
          "editorMode": "code",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus-1"
          },
          "legendFormat": ""
        },
        {
          "refId": "C",
          "expr": "label_replace((max by (server, environment) ((1 - (node_memory_MemAvailable_bytes{job=~\"server-0[123]\"} / node_memory_MemTotal_bytes{job=~\"server-0[123]\"})) * 100)), \"__name__\", \"mem_pct\", \"server\", \".+\")",
          "instant": true,
          "range": false,
          "editorMode": "code",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus-1"
          },
          "legendFormat": ""
        },
        {
          "refId": "D",
          "expr": "label_replace((max by (server, environment) ((\n  (\n    (\n      (node_memory_SwapTotal_bytes{job=~\"server-0[123]\"} - node_memory_SwapFree_bytes{job=~\"server-0[123]\"})\n      / node_memory_SwapTotal_bytes{job=~\"server-0[123]\"}\n    ) * 100\n  )\n  and on(server, environment, instance, job)\n  (node_memory_SwapTotal_bytes{job=~\"server-0[123]\"} > 0)\n)\nor\n(\n  (node_memory_SwapTotal_bytes{job=~\"server-0[123]\"} == bool 0) * 0\n))), \"__name__\", \"swap_pct\", \"server\", \".+\")",
          "instant": true,
          "range": false,
          "editorMode": "code",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus-1"
          },
          "legendFormat": ""
        },
        {
          "refId": "E",
          "expr": "label_replace((max by (server, environment) (100 * (1 - (node_filesystem_avail_bytes{mountpoint=\"/\",fstype!~\"tmpfs|overlay|squashfs\",job=~\"server-0[123]\"} / node_filesystem_size_bytes{mountpoint=\"/\",fstype!~\"tmpfs|overlay|squashfs\",job=~\"server-0[123]\"})))), \"__name__\", \"disk_pct\", \"server\", \".+\")",
          "instant": true,
          "range": false,
          "editorMode": "code",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus-1"
          },
          "legendFormat": ""
        },
        {
          "refId": "F",
          "expr": "label_replace((max by (server, environment) (node_load1{job=~\"server-0[123]\"})), \"__name__\", \"load1\", \"server\", \".+\")",
          "instant": true,
          "range": false,
          "editorMode": "code",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus-1"
          },
          "legendFormat": ""
        },
        {
          "refId": "G",
          "expr": "label_replace((max by (server, environment) (time() - node_boot_time_seconds{job=~\"server-0[123]\"})), \"__name__\", \"uptime_s\", \"server\", \".+\")",
          "instant": true,
          "range": false,
          "editorMode": "code",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus-1"
          },
          "legendFormat": ""
        }
      ],
      "transformations": [
        {
          "id": "joinByLabels",
          "options": {
            "join": [
              "server",
              "environment"
            ],
            "value": "__name__"
          }
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "instance": true,
              "job": true,
              "Time": true,
              "__name__": true,
              "mountpoint": true,
              "fstype": true,
              "device": true
            },
            "indexByName": {
              "server": 0,
              "environment": 1,
              "up_status": 2,
              "cpu_pct": 3,
              "mem_pct": 4,
              "swap_pct": 5,
              "disk_pct": 6,
              "load1": 7,
              "uptime_s": 8
            },
            "renameByName": {
              "server": "Server",
              "environment": "Environment",
              "up_status": "Status",
              "cpu_pct": "CPU",
              "mem_pct": "Memory",
              "swap_pct": "Swap",
              "disk_pct": "Disk",
              "load1": "Load",
              "uptime_s": "Uptime"
            }
          }
        },
        {
          "id": "sortBy",
          "options": {
            "sort": [
              {
                "desc": false,
                "field": "Server"
              }
            ]
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Status"
            },
            "properties": [
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "0": {
                        "text": "DOWN",
                        "color": "red",
                        "index": 0
                      },
                      "1": {
                        "text": "UP",
                        "color": "green",
                        "index": 1
                      }
                    }
                  }
                ]
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "mode": "basic",
                  "type": "color-background"
                }
              },
              {
                "id": "decimals",
                "value": 0
              },
              {
                "id": "custom.width",
                "value": 110
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "CPU"
            },
            "properties": [
              {
                "id": "unit",
                "value": "percent"
              },
              {
