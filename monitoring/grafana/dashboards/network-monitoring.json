  "version": 1,
  "uid": "network-monitoring",
  "title": "Network Monitoring",
  "description": "Traffic, errors, and drops on real interfaces. Loopback and container bridges are excluded. Visual theme: Sunset Orange.",
  "templating": {
    "list": [
      {
        "name": "server",
        "label": "Server",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus-1"
        },
        "definition": "label_values(up{job=~\"server-0[123]\"}, server)",
        "query": {
          "query": "label_values(up{job=~\"server-0[123]\"}, server)",
          "refId": "StandardVariableQuery"
        },
        "includeAll": true,
        "allValue": ".+",
        "multi": false,
        "refresh": 1,
        "sort": 1,
        "current": {
          "selected": true,
          "text": "All",
          "value": "$__all"
        },
        "options": [
          {
            "selected": true,
            "text": "All",
            "value": "$__all"
          }
        ],
        "regex": "",
        "hide": 0
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "text",
      "gridPos": {
        "h": 2,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "options": {
        "mode": "markdown",
        "content": "These charts use the same interface filter as Server details. Docker bridge and loopback traffic is hidden so the host link is visible."
      }
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Download",
      "description": "Traffic arriving at the server, excluding loopback and Docker bridges.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus-1"
      },
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 0,
        "y": 2
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (server) (rate(node_network_receive_bytes_total{device!~\"lo|veth.*|docker.*|br-.*|cali.*|flannel.*|cni.*|virbr.*\",job=~\"server-0[123]\",server=~\"^(?:${server})$\"}[5m]))",
          "instant": false,
          "range": true,
          "editorMode": "code",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus-1"
          },
          "legendFormat": "{{server}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "Bps",
          "decimals": 1,
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "lineWidth": 2,
            "fillOpacity": 16,
            "gradientMode": "opacity",
            "showPoints": "never",
            "pointSize": 5,
            "spanNulls": false,
            "axisSoftMin": 0,
            "axisPlacement": "auto"
          },
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Maxbridge Development Server"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#fb923c"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Dhellavita"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#fbbf24"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Citysync"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#fdba74"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
