{
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "editable": false,
  "graphTooltip": 1,
  "links": [],
  "panels": [
    {
      "datasource": { "type": "prometheus", "uid": "prometheus-1" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "fixed", "fixedColor": "blue" },
          "noValue": "0"
        },
        "overrides": []
      },
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 0 },
      "id": 1,
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center",
        "orientation": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "auto"
      },
      "targets": [
        {
          "expr": "count(probe_success{job=\"blackbox-http\",website=~\"${website:regex}\"})",
          "refId": "A"
        }
      ],
      "title": "Total Websites",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus-1" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "noValue": "0",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "green", "value": 1 }
            ]
          }
        },
        "overrides": []
      },
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 0 },
      "id": 2,
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center",
        "orientation": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "auto"
      },
      "targets": [
        {
          "expr": "sum(probe_success{job=\"blackbox-http\",website=~\"${website:regex}\"})",
          "refId": "A"
        }
      ],
      "title": "Websites UP",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus-1" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "noValue": "0",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 1 }
            ]
          }
        },
        "overrides": []
      },
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 0 },
      "id": 3,
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center",
        "orientation": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "auto"
      },
      "targets": [
        {
          "expr": "count(probe_success{job=\"blackbox-http\",website=~\"${website:regex}\"}) - sum(probe_success{job=\"blackbox-http\",website=~\"${website:regex}\"})",
          "refId": "A"
        }
      ],
      "title": "Websites DOWN",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus-1" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "noValue": "0",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 1 }
            ]
          }
        },
        "overrides": []
      },
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 0 },
      "id": 4,
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center",
        "orientation": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "auto"
      },
      "targets": [
        {
          "expr": "(count((probe_ssl_earliest_cert_expiry{job=\"blackbox-http\",website=~\"${website:regex}\"} - time()) < 14 * 24 * 3600 and probe_ssl_earliest_cert_expiry{job=\"blackbox-http\",website=~\"${website:regex}\"} > 0) or vector(0))",
          "refId": "A"
        }
      ],
      "title": "SSL Expiring in 14 Days",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus-1" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": { "color": "red", "index": 0, "text": "DOWN" },
                "1": { "color": "green", "index": 1, "text": "UP" }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "green", "value": 1 }
            ]
          }
        },
        "overrides": []
      },
      "gridPos": { "h": 12, "w": 24, "x": 0, "y": 4 },
      "id": 5,
      "options": {
        "legend": { "displayMode": "hidden", "placement": "bottom" },
        "mergeValues": true,
        "showValue": "auto",
        "tooltip": { "mode": "single", "sort": "none" }
      },
      "targets": [
        {
          "expr": "probe_success{job=\"blackbox-http\",website=~\"${website:regex}\"}",
          "legendFormat": "{{website}}",
          "refId": "A"
        }
      ],
      "title": "Up / Down",
      "type": "state-timeline"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus-1" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "green", "value": 1 }
            ]
          }
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "Status" },
            "properties": [
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "0": { "color": "red", "index": 0, "text": "DOWN" },
                      "1": { "color": "green", "index": 1, "text": "UP" }
                    }
                  }
                ]
              },
              {
                "id": "custom.cellOptions",
                "value": { "mode": "basic", "type": "color-background" }
              }
            ]
          }
        ]
      },
      "gridPos": { "h": 12, "w": 24, "x": 0, "y": 16 },
      "id": 6,
      "options": {
        "cellHeight": "sm",
        "showHeader": true,
        "sortBy": [{ "desc": false, "displayName": "Website" }]
      },
      "targets": [
        {
          "expr": "probe_success{job=\"blackbox-http\",website=~\"${website:regex}\"}",
          "format": "table",
          "instant": true,
          "refId": "A"
        }
      ],
      "title": "Current Status",
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "__name__": true,
              "job": true,
              "instance": true,
              "target": true
            },
            "indexByName": { "website": 0, "Value": 1 },
            "renameByName": { "website": "Website", "Value": "Status" }
          }
        }
      ],
      "type": "table"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus-1" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "decimals": 2,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 2 },
              { "color": "red", "value": 5 }
            ]
          },
          "unit": "s"
        },
        "overrides": []
      },
      "gridPos": { "h": 10, "w": 12, "x": 0, "y": 28 },
      "id": 7,
      "options": { "cellHeight": "sm", "showHeader": true },
      "targets": [
        {
          "expr": "probe_duration_seconds{job=\"blackbox-http\",website=~\"${website:regex}\"}",
          "format": "table",
          "instant": true,
          "refId": "A"
        }
      ],
      "title": "Response Time",
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "__name__": true,
              "job": true,
              "instance": true,
              "target": true
            },
            "indexByName": { "website": 0, "Value": 1 },
            "renameByName": { "website": "Website", "Value": "Response Time" }
          }
        }
      ],
      "type": "table"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus-1" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "green", "value": 200 },
              { "color": "orange", "value": 400 },
              { "color": "red", "value": 500 }
            ]
          }
        },
        "overrides": []
      },
      "gridPos": { "h": 10, "w": 12, "x": 12, "y": 28 },
      "id": 8,
      "options": { "cellHeight": "sm", "showHeader": true },
      "targets": [
        {
          "expr": "probe_http_status_code{job=\"blackbox-http\",website=~\"${website:regex}\"}",
          "format": "table",
          "instant": true,
          "refId": "A"
        }
      ],
      "title": "HTTP Status",
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "__name__": true,
              "job": true,
              "instance": true,
              "target": true
            },
            "indexByName": { "website": 0, "Value": 1 },
            "renameByName": { "website": "Website", "Value": "HTTP Code" }
          }
        }
      ],
      "type": "table"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus-1" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "decimals": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "orange", "value": 3 },
              { "color": "yellow", "value": 14 },
              { "color": "green", "value": 30 }
            ]
          },
          "unit": "d"
        },
        "overrides": []
      },
      "gridPos": { "h": 12, "w": 24, "x": 0, "y": 38 },
      "id": 9,
      "options": { "cellHeight": "sm", "showHeader": true },
      "targets": [
        {
          "expr": "(probe_ssl_earliest_cert_expiry{job=\"blackbox-http\",website=~\"${website:regex}\"} - time()) / 86400",
          "format": "table",
          "instant": true,
          "refId": "A"
        }
      ],
      "title": "SSL Days Remaining",
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "__name__": true,
              "job": true,
              "instance": true,
              "target": true
            },
            "indexByName": { "website": 0, "Value": 1 },
            "renameByName": { "website": "Website", "Value": "Days Left" }
          }
        }
      ],
      "type": "table"
    }
  ],
  "refresh": "30s",
  "schemaVersion": 39,
  "tags": ["website", "blackbox", "uptime", "ssl"],
  "templating": {
    "list": [
      {
        "allValue": ".*",
        "current": {
          "selected": true,
          "text": ["All"],
          "value": ["$__all"]
        },
        "datasource": { "type": "prometheus", "uid": "prometheus-1" },
        "definition": "label_values(probe_success{job=\"blackbox-http\"}, website)",
        "includeAll": true,
        "label": "Website",
        "multi": true,
        "name": "website",
        "options": [],
        "query": {
          "query": "label_values(probe_success{job=\"blackbox-http\"}, website)",
          "refId": "StandardVariableQuery"
        },
        "refresh": 1,
        "sort": 1,
        "type": "query"
      }
    ]
  },
  "time": { "from": "now-6h", "to": "now" },
  "timepicker": {},
  "timezone": "browser",
  "title": "Website Monitoring",
  "uid": "website-monitoring",
  "version": 2
}
